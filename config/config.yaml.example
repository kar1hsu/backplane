# 全局时区，统一日志 / JWT / 数据库 / 定时任务等所有带时区的地方（IANA 名，如 Asia/Shanghai、UTC）
# docker 部署时可由 compose 的 TIMEZONE 环境变量覆盖
timezone: Asia/Shanghai

server:
  port: 8080
  mode: debug # debug | release | test
  # 允许的跨域来源；留空或不配置则回退为 "*"。生产环境建议配置显式白名单：
  # allow_origins:
  #   - https://admin.example.com

database:
  driver: mysql # mysql | postgres
  host: 127.0.0.1
  port: 3306
  username: root
  password: root
  dbname: backplane
  charset: utf8mb4
  max_idle_conns: 10
  max_open_conns: 100
  log_level: info # silent | error | warn | info

redis:
  host: 127.0.0.1
  port: 6379
  password: ""
  db: 0
  key_prefix: "backplane:"   # Redis key 全局前缀，避免多项目 key 冲突

jwt:
  secret: backplane-jwt-secret-key-change-in-production
  expire: 7200    # token 过期时间（秒）
  issuer: backplane

casbin:
  model_path: config/rbac_model.conf

task:
  concurrency: 10                  # Worker 并发数
  queues:                          # 队列列表（按优先级从高到低）
    - critical
    - default
    - low

log:
  level: info       # debug | info | warn | error
  format: console   # console | json
  directory: logs    # 文件日志目录；当前文件为 app.log
  max_size: 100      # MB，达到大小后轮转，不按天主动切分
  max_backups: 10    # 保留旧日志文件数量
  max_age: 30        # days，文件日志旧文件最长保留天数；0 表示不按天数清理。数据库操作日志由系统配置 log.operation_retain_days 控制
