GROUP_NAME=backplane
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=backplane
REDIS_PASSWORD=
POSTGRES_DB=backplane
POSTGRES_USER=backplane
POSTGRES_PASSWORD=backplane
# 上传目录；相对路径以 deploy/docker-compose.yaml 所在目录为基准
UPLOAD_DIR=../storage/uploads
# 应用时区：注入到 server/worker/scheduler 的 TIMEZONE，决定应用 time.Local
# （日志 / JWT / 定时任务 / 数据库时间）。MySQL、Redis 不依赖它。
TZ=Asia/Shanghai
